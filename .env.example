# ── Required in production ──────────────────────────────────────────────
DATABASE_URL=postgres://postgres@127.0.0.1:54329/chefdonn
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-32+-random-characters
# The first person to sign in with this email creates the workspace (once).
BOOTSTRAP_OWNER_EMAIL=you@example.com

# ── Email (production). Without it, sign-in links go to /api/dev/mailbox ──
RESEND_API_KEY=
MAIL_FROM="Chef Donn's <login@your-domain.ph>"
# A deployment without Resend yet: print sign-in links to the server logs instead (opt-in).
# Never use ENABLE_DEV_MAILBOX on a public deployment — that page lists links without auth.
SIGNIN_LINKS_TO_LOGS=

# ── AI (receipts + price search). Without a key, both are off and say so ──
ANTHROPIC_API_KEY=
# Only if the key wasn't created inside an Anthropic workspace (the API then asks for one):
# the workspace id from Console → Settings → Workspaces, e.g. wrkspc_…
ANTHROPIC_WORKSPACE_ID=
RECEIPT_MODEL=claude-opus-5-5
PRICE_MODEL=claude-opus-5-5
PRICE_SEARCH_DAILY_LIMIT=50
# Local demos without a key: AI_EXTRACTOR=fake PRICE_PROVIDER=fake (clearly labelled test data)
AI_EXTRACTOR=
PRICE_PROVIDER=

# ── Receipt storage ─────────────────────────────────────────────────────
STORAGE_DRIVER=fs          # fs | s3
STORAGE_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=1

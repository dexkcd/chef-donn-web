{
  "name": "chef-donn-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:db && pnpm e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "pg:start": "bash scripts/pg-local.sh start",
    "pg:stop": "bash scripts/pg-local.sh stop",
    "eval:receipts": "tsx scripts/eval-receipts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@aws-sdk/client-s3": "3.1150.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "idb": "8.0.4",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.28.0"
}
